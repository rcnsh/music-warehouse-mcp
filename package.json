{
  "name": "music-warehouse-mcp",
  "version": "0.1.0",
  "description": "MCP server for a music-warehouse Worker: lets an AI agent query your stored Spotify listening history.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rcnsh/music-warehouse-mcp.git"
  },
  "bin": {
    "music-warehouse-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/index.js",
    "login": "node dist/index.js login",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js",
    "prepare": "tsc",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
